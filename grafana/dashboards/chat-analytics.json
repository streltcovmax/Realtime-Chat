                        "rawSql": "SELECT countIf(last_status = 'ONLINE') AS online_users FROM (SELECT user_id, argMax(status, event_time) AS last_status FROM chat_analytics.events WHERE event_type = 'user_status_changed' AND user_id != '' GROUP BY user_id)"
